FROM golang:1.27.1-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/server ./cmd/server && CGO_ENABLED=0 go build -trimpath -o /out/rungrid ./cmd/cli
FROM debian:bookworm-slim
RUN useradd --uid 10001 --create-home rungrid
COPY --from=build /out/ /usr/local/bin/
USER rungrid
ENTRYPOINT ["server"]
